(version 1)
# Abstaende der 230-V-Seite. Spaetere Regeln haben Vorrang vor frueheren.

(rule "Netz zu Kleinspannung"
	(condition "A.NetClass == 'Netz' && B.NetClass != 'Netz' && B.NetName != ''")
	(constraint clearance (min 6mm)))

(rule "Netz untereinander"
	(condition "A.NetClass == 'Netz' && B.NetClass == 'Netz' && A.Net != B.Net")
	(constraint clearance (min 2.5mm)))

# Ausnahmen, die durch Bauteilgehaeuse vorgegeben sind
(rule "Teilerkette R1 R2"
	(condition "(A.NetName == '/L_LICHT' && B.NetName == '/LICHT_A') || (A.NetName == '/LICHT_A' && B.NetName == '/L_LICHT') || (A.NetName == '/LICHT_A' && B.NetName == '/LICHT_B') || (A.NetName == '/LICHT_B' && B.NetName == '/LICHT_A')")
	(constraint clearance (min 1.5mm)))

(rule "Optokoppler-Eingang U2"
	(condition "(A.NetName == '/LICHT_B' && B.NetName == '/N') || (A.NetName == '/N' && B.NetName == '/LICHT_B')")
	(constraint clearance (min 0.5mm)))

(rule "Snubber R5"
	(condition "(A.NetName == '/SNUB' && B.NetName == '/L_F') || (A.NetName == '/L_F' && B.NetName == '/SNUB')")
	(constraint clearance (min 1.5mm)))

(rule "Optotriac U3: Substrat-Pin 5 zwischen den Ausgangspins"
	(condition "(A.NetName == 'unconnected-(U3-SUB-Pad5)' && B.NetClass == 'Netz') || (B.NetName == 'unconnected-(U3-SUB-Pad5)' && A.NetClass == 'Netz')")
	(constraint clearance (min 0.5mm)))

(rule "Gate-Widerstand R17 zwischen Gate und COM von Q1"
	(condition "(A.NetName == '/TRIAC_G' && B.NetName == '/L_F') || (A.NetName == '/L_F' && B.NetName == '/TRIAC_G')")
	(constraint clearance (min 0.5mm)))

(rule "Zuendwiderstand R16 zwischen Optotriac und OUT von Q1"
	(condition "(A.NetName == '/OPTO_R' && B.NetName == '/L_FAN') || (A.NetName == '/L_FAN' && B.NetName == '/OPTO_R')")
	(constraint clearance (min 1.0mm)))
